{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tausi POS",
  "version": "0.1.0",
  "identifier": "com.nexagensolutions.tausipos",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "NexaGen Solutions",
    "copyright": "© NexaGen Solutions",
    "category": "Business",
    "shortDescription": "Tausi POS terminal for counter PCs",
    "longDescription": "Tausi POS by NexaGen Solutions: the full-screen point-of-sale terminal for bars and restaurants. It shows the POS screens served by Tausi Server on the local network.",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
