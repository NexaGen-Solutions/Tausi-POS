{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tausi POS",
  "version": "1.0.0",
  "identifier": "com.nexagensolutions.tausipos",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http: https:",
        "img-src": "'self' data: blob: http: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "NexaGen Solutions",
    "copyright": "© NexaGen Solutions",
    "category": "Business",
    "shortDescription": "Tausi POS terminal for counter PCs",
    "longDescription": "Tausi POS by NexaGen Solutions: the full-screen point-of-sale terminal for bars and restaurants. It shows the POS screens served by Tausi Server on the local network.",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "windows/installer.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp"
      }
    },
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES.txt",
      "../../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0RDI4MjMwOTVERkE4MEQKUldRTnFOK1ZNSUxTcE91ZEtBYitzaFlzWTlCc3hCYW4yZlR3aTVzZkZCMFlhbW9mVHpMQ0RDMlUK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
