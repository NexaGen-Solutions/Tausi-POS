# Tausi POS Server settings (/etc/tausi/tausi.env, readable by root and the tausi user only).
# install.sh writes this file; edit it and run `sudo systemctl restart tausi` to change a setting.

# The database (PostgreSQL). install.sh --with-postgres fills this in with a random password.
ConnectionStrings__Tausi=Host=localhost;Port=5432;Database=tausipos;Username=tausi;Password=CHANGE-ME
Database__Provider=Postgres

# Folders: settings and data under /var/lib/tausi, logs in /var/log/tausi.
Tausi__Home=/var/lib/tausi
Tausi__LogDirectory=/var/log/tausi

# The port terminals and browsers use.
Urls=http://0.0.0.0:5080
